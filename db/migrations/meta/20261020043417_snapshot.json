      "checkConstraints": {
        "content_locale_valid": {
          "name": "content_locale_valid",
          "value": "\"content_posts\".\"locale\" IN ('vi', 'en', 'zh-CN')"
        },
        "content_kind_valid": {
          "name": "content_kind_valid",
          "value": "\"content_posts\".\"kind\" IN ('article', 'news', 'event')"
        },
        "content_status_valid": {
          "name": "content_status_valid",
          "value": "\"content_posts\".\"status\" IN ('draft', 'published')"
        },
        "content_title_nonempty": {
          "name": "content_title_nonempty",
          "value": "length(\"content_posts\".\"title\") BETWEEN 1 AND 200"
        },
        "content_description_nonempty": {
          "name": "content_description_nonempty",
          "value": "length(\"content_posts\".\"description\") BETWEEN 1 AND 500"
        },
        "content_body_size": {
          "name": "content_body_size",
          "value": "length(CAST(\"content_posts\".\"body\" AS BLOB)) <= 204800"
        },
        "content_version_positive": {
          "name": "content_version_positive",
          "value": "\"content_posts\".\"version\" > 0"
        },
        "content_published_has_date": {
          "name": "content_published_has_date",
          "value": "\"content_posts\".\"status\" != 'published' OR \"content_posts\".\"published_at\" IS NOT NULL"
        },
        "content_event_fields": {
          "name": "content_event_fields",
          "value": "(\"content_posts\".\"kind\" = 'event' AND \"content_posts\".\"starts_at\" IS NOT NULL AND \"content_posts\".\"location\" IS NOT NULL)\n        OR (\"content_posts\".\"kind\" != 'event' AND \"content_posts\".\"starts_at\" IS NULL AND \"content_posts\".\"ends_at\" IS NULL AND \"content_posts\".\"location\" IS NULL)"
        },
        "content_event_order": {
          "name": "content_event_order",
          "value": "\"content_posts\".\"ends_at\" IS NULL OR \"content_posts\".\"starts_at\" IS NULL OR \"content_posts\".\"ends_at\" >= \"content_posts\".\"starts_at\""
        }
      }
    },
