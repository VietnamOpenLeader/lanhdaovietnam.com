{
  "name": "lanhdaovietnam.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "void prepare && bun run i18n:compile && bun --check",
    "test:api": "bun scripts/test-local.ts api",
    "test:cli": "bun scripts/test-local.ts cli",
    "test:e2e": "bun scripts/test-local.ts e2e",
    "test:migrations:d1": "bash scripts/test-migrations-d1.sh",
    "test:unit": "bun run i18n:compile && bun test tests/unit",
    "format": "vp fmt . --write",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "ship:gate": "bash scripts/ship-gate.sh",
    "content": "bun scripts/content.ts",
    "content:check": "bun scripts/check-content.ts",
    "i18n:extract": "lingui extract",
    "i18n:check": "bun scripts/check-catalogs.ts && lingui check sync",
    "i18n:compile": "lingui compile --typescript --strict",
    "build": "bun run content:check && bun run i18n:check && bun run i18n:compile && vite build",
    "check": "bun run format:check && bun run lint && bun run i18n:check && bun run i18n:compile && bun run typecheck && bun run test:unit && bun run test:api && bun run test:cli && bun run test:migrations:d1 && bun run build"
  },
  "dependencies": {
    "@cloudflare/kumo": "2.15.0",
    "@lingui/core": "6.10.1",
    "@lingui/react": "6.10.1",
    "@phosphor-icons/react": "2.1.10",
    "@void/md": "1.2.1",
    "@void/react": "1.2.1",
    "@xstate/effect": "1.0.0-alpha.9",
    "@xstate/react": "7.0.0-alpha.6",
    "effect": "4.0.6",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "xstate": "6.0.0-alpha.70",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@lingui/cli": "6.10.1",
    "@lingui/format-json": "6.10.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/markdown-it": "14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plus": "1.4.0",
    "void": "1.2.1"
  },
  "packageManager": "bun@1.4.4"
}
