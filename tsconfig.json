{
  "extends": "./.void/tsconfig.json",
  "include": [
    "src/**/*.ts", "src/**/*.tsx", "pages/**/*.ts", "pages/**/*.tsx",
    "routes/**/*.ts", "middleware/**/*.ts", "db/**/*.ts",
    "scripts/**/*.ts", "tests/**/*.ts", "env.ts", "lingui.config.ts",
    "vite.config.mts", "void.config.ts", "playwright.config.ts"
  ],
  "exclude": ["src/router.tsx", "src/routes/**", ".void/test-projects/**"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "void/env", "bun"]
  }
}
